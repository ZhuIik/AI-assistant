# Скопируйте этот файл в .env и заполните реальными значениями.
# .env добавлен в .gitignore и не должен попадать в репозиторий.

# Токен Telegram-бота от @BotFather (нужен только для scripts/bot.py)
BOT_TOKEN=

# Адрес HTTP API, который опрашивает bot.py
SERVER_URL=http://127.0.0.1:5000/chat

# Локальный OpenAI-совместимый сервер (LM Studio / vLLM и т.п.)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=google/gemma-4-e4b

# Модель для офлайн-разметки аннотаций (scripts/prefill_annotations.py).
# Можно оставить пустым - по умолчанию равна LM_STUDIO_MODEL.
ANNOTATE_MODEL=

# Embedding-модель для RAG-индекса (src/rag/embedder.py), тоже через LM Studio.
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# Токен HuggingFace (нужен только для диаризации спикеров: pyannote/speaker-diarization-3.1)
HUGGINGFACE_TOKEN=
