0\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0438.\"", "verdict": 1}, {"statement": "\u0417\u043d\u0430\u043d\u0438\u0435 BPMN \u043f\u043e\u043c\u043e\u0433\u0430\u0435\u0442 \u043f\u043e\u043d\u044f\u0442\u044c, \u043a\u0430\u043a \u0438\u043c\u0435\u043d\u043d\u043e \u043f\u0440\u043e\u0442\u0435\u043a\u0430\u0435\u0442 \u0431\u0438\u0437\u043d\u0435\u0441-\u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u043e\u0442 \u043d\u0430\u0447\u0430\u043b\u0430 \u0434\u043e \u043a\u043e\u043d\u0446\u0430.", "reason": "\u041a\u043e\u043d\u0442\u0435\u043a\u0441\u0442 \u0443\u043f\u043e\u043c\u0438\u043d\u0430\u0435\u0442, \u0447\u0442\u043e \u043f\u0440\u0438 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0438 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u0430 \"\u0418 \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u0438\u0434\u0435\u0442 \u0441\u0442\u0440\u043e\u0433\u043e \u043f\u043e \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u043a\u0430\u043c, \u0443\u0441\u043b\u043e\u0432\u043d\u043e, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u044b \u0440\u0438\u0441\u0443\u0435\u0442\u0435.\"", "verdict": 1}, {"statement": "\u041f\u0440\u0438 \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0442\u0430\u043a\u0438\u0445 \u043f\u0440\u043e\u0446\u0435\u0441\u0441\u043e\u0432 \u043d\u0430 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0430\u0445, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, ELMA, \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u0438\u0434\u0435\u0442 \u0441\u0442\u0440\u043e\u0433\u043e \u043f\u043e \u0437\u0430\u0434\u0430\u043d\u043d\u044b\u043c \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u043a\u0430\u043c.", "reason": "\u041a\u043e\u043d\u0442\u0435\u043a\u0441\u0442 \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442: \"\u0418 \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u0438\u0434\u0435\u0442 \u0441\u0442\u0440\u043e\u0433\u043e \u043f\u043e \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u043a\u0430\u043c, \u0443\u0441\u043b\u043e\u0432\u043d\u043e, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u044b \u0440\u0438\u0441\u0443\u0435\u0442\u0435.\"", "verdict": 1}, {"statement": "\u042d\u0442\u043e \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0433\u043e \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u043e\u0433\u043e \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u044f \u0432\u0441\u0435\u0433\u043e \u0446\u0438\u043a\u043b\u0430.", "reason": "\u0412 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0435 \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u0441\u044f \u043e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c \u0431\u0438\u0437\u043d\u0435\u0441-\u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u0438 \u0434\u0430\u043b\u0435\u0435 \"\u0432\u044b \u0437\u0430\u043f\u0447\u0435\u0448\u043a\u0430\u0435\u0442\u0435 \u043e\u043f\u043b\u0430\u0442\u043a\u0443. \u0418 \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u0438\u0434\u0435\u0442 \u0441\u0442\u0440\u043e\u0433\u043e \u043f\u043e \u043a\u0432\u0430\u0434\u0440\u0430\u0442\u0438\u043a\u0430\u043c...\"", "verdict": 1}, {"statement": "\u0422\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c, BPMN \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u0435\u0442 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u043c \u0434\u043b\u044f \u0432\u0438\u0437\u0443\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u0438 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0432\u0441\u0435\u0445 \u044d\u0442\u0430\u043f\u043e\u0432 \u0440\u0430\u0431\u043e\u0442\u044b.", "reason": "\u0425\u043e\u0442\u044f \u044d\u0442\u043e \u043d\u0435 \u043f\u0440\u044f\u043c\u043e\u0435 \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u0438\u0435, \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442 \u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u04